# Public URL of the deployed site (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com) - powers the contact form
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where enquiries are delivered
CONTACT_TO_EMAIL=hello@khanzadi.design
# Verified sender. Use "Portfolio <onboarding@resend.dev>" for testing, then a verified domain address
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional: Google Search Console verification token (the content="" value of the meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=
# Optional: Plausible analytics domain (e.g. khanzadi.design). Leave empty to disable
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
